# ============================================================================
# ClassWatch — exemple de configuration locale
# Copie ce fichier en ".env" et renseigne ta vraie clé.
# NE COMMITE JAMAIS le fichier .env (il est dans .gitignore).
# ============================================================================

# --- Clé API Google Gemini (backend recommandé) ----------------------------
# Crée une clé sur https://aistudio.google.com/apikey
# Une clé valide commence en général par "AIza...".
GEMINI_API_KEY=AIza_remplace_par_ta_cle

# Variante acceptée (compatibilité) : GOOGLE_API_KEY a la même fonction.
# GOOGLE_API_KEY=AIza_remplace_par_ta_cle

# Modèle Gemini (optionnel). Par défaut : gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Backend alternatif Anthropic (optionnel, non utilisé par défaut) -------
# ANTHROPIC_API_KEY=sk-ant-...
